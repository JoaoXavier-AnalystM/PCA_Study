
// ============================================================
// NAVIGATION
// ============================================================
function toggleSidebar() {
  const nav = document.getElementById('sidebar');
  nav.classList.toggle('collapsed');
  localStorage.setItem('pca_sidebar_collapsed', nav.classList.contains('collapsed'));
}

(function initSidebar() {
  if (localStorage.getItem('pca_sidebar_collapsed') === 'true') {
    document.getElementById('sidebar').classList.add('collapsed');
  }
})();

// ============================================================
// THEME
// ============================================================
function getTheme() {
  return localStorage.getItem('pca_theme') || 'dark';
}
function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  localStorage.setItem('pca_theme', theme);
  // day content inherits parent theme via CSS variables — no action needed
}
function toggleTheme() {
  const next = getTheme() === 'dark' ? 'light' : 'dark';
  // transição suave temporária — classe remove o !important após 300ms
  const root = document.documentElement;
  root.classList.add('theme-switching');
  applyTheme(next);
  setTimeout(() => root.classList.remove('theme-switching'), 300);
}
// init theme on load
applyTheme(getTheme());

function show(id) {
  window.scrollTo({ top: 0, behavior: 'instant' });
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => {
    b.classList.remove('active');
    b.removeAttribute('aria-current');
  });
  document.getElementById(id).classList.add('active');
  const btns = document.querySelectorAll('.nav-btn');
  const map = {mindmap:0, plano:1, cheat:2, promqlref:3, quiz:4, promql:5};
  const activeBtn = btns[map[id]];
  activeBtn.classList.add('active');
  activeBtn.setAttribute('aria-current', 'page');
  closeDayStudy();
}

// ============================================================
// DAY STUDY NAVIGATION
// ============================================================
function loadDayStudy(dayNum) {
  const container = document.getElementById('dayStudyContainer');
  const content = document.getElementById('dayStudyContent');
  const title = document.getElementById('dayStudyTitle');

  const dayNames = [
    '',
    'Tópico 1 — Observability + Fundamentos',
    'Tópico 2 — PromQL Básico',
    'Tópico 3 — PromQL Avançado',
    'Tópico 4 — Instrumentação & Exporters',
    'Tópico 5 — Alerting & Dashboarding',
    'Tópico 6 — Simulados + Revisão',
    'Tópico 7 — Revisão Rápida + Exam Day'
  ];

  title.textContent = dayNames[dayNum];
  content.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted)">Carregando...</div>';
  container.style.display = 'block';

  fetch('day' + dayNum + '.html')
    .then(r => r.text())
    .then(html => {
      // extract body content and strip the style/script blocks
      var bodyMatch = html.match(/<body[^>]*>([\s\S]*)<\/body>/i);
      var body = bodyMatch ? bodyMatch[1] : html;
      // remove style and script blocks
      body = body.replace(/<style[\s\S]*?<\/style>/gi, '');
      body = body.replace(/<script[\s\S]*?<\/script>/gi, '');
      // remove leftover head content if any
      body = body.replace(/<head[\s\S]*?<\/head>/gi, '');
      // wrap in a div with scoped class
      content.innerHTML = body;
    })
    .catch(function() {
      content.innerHTML = '<div style="text-align:center;padding:40px;color:var(--accent3)">Erro ao carregar conteúdo.</div>';
    });

  const visited = JSON.parse(localStorage.getItem('pca_visited_days') || '[]');
  if (!visited.includes(dayNum)) {
    visited.push(dayNum);
    localStorage.setItem('pca_visited_days', JSON.stringify(visited));
  }
  markVisitedDays(visited);

  setTimeout(() => {
    container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
}

function markVisitedDays(visited) {
  // first remove all existing badges
  document.querySelectorAll('.visited-badge').forEach(b => b.remove());
  visited.forEach(d => {
    const card = document.querySelector(`.day-card[data-day="${d}"]`);
    if (card) {
      card.querySelector('.day-body').insertAdjacentHTML('beforeend', '<span class="visited-badge">✓ Revisado</span>');
    }
  });
}
function resetVisited() {
  localStorage.removeItem('pca_visited_days');
  document.querySelectorAll('.visited-badge').forEach(b => b.remove());
}

function closeDayStudy() {
  const container = document.getElementById('dayStudyContainer');
  const content = document.getElementById('dayStudyContent');
  if (!container) return;
  container.style.display = 'none';
  if (content) content.innerHTML = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ============================================================
// QUIZ DATA
// ============================================================
const questions = [
  // OBSERVABILITY (9q)
  {domain:"Observability", q:"Qual a principal diferença entre SLO e SLA?", opts:["SLO é o contrato com o cliente; SLA é a meta interna do time","SLA é o contrato com o cliente; SLO é a meta interna/técnica do time","SLO e SLA são sinônimos no contexto de observabilidade","SLA é o indicador medido; SLO é o alerta disparado"], ans:1, exp:"<strong>SLA (Service Level Agreement)</strong> é o contrato formal com o cliente. <strong>SLO (Service Level Objective)</strong> é a meta técnica interna que o time define para garantir o SLA. O SLI é a métrica real medida."},
  {domain:"Observability", q:"No modelo push vs pull do Prometheus, qual é o comportamento padrão?", opts:["Push — o app envia métricas ao Prometheus","Pull — o Prometheus scrapa o endpoint /metrics dos targets","Ambos são usados simultaneamente por padrão","O modelo depende do tipo de exporter usado"], ans:1, exp:"Prometheus usa o modelo <strong>pull</strong> por padrão: ele faz scrape periódico do endpoint <code>/metrics</code> de cada target. O Pushgateway existe para casos em que o push é necessário (batch jobs)."},
  {domain:"Observability", q:"Qual pilar da observabilidade é MAIS adequado para rastrear uma requisição atravessando múltiplos microsserviços?", opts:["Métricas","Logs","Traces (rastreamento distribuído)","Alertas"], ans:2, exp:"<strong>Distributed Tracing</strong> com spans é a solução para rastrear o caminho de uma requisição através de múltiplos serviços. OpenTelemetry e Jaeger são ferramentas dessa categoria."},
  {domain:"Observability", q:"Um SLI mede:", opts:["A penalidade contratual quando o SLA é violado","O valor real de uma métrica de desempenho do serviço","A meta percentual que o time quer atingir","O orçamento de erros disponível"], ans:1, exp:"<strong>SLI (Service Level Indicator)</strong> é a métrica real e observável — por exemplo, a disponibilidade medida nos últimos 30 dias. É o número que comparamos com o SLO."},
  {domain:"Observability", q:"Por que logs são menos adequados que métricas para alertas em tempo real?", opts:["Logs não podem ser consultados em queries","Logs têm alto volume e custo de armazenamento/processamento para alertas de baixa latência","Logs não registram erros de sistema","Logs não suportam timestamps"], ans:1, exp:"Métricas são dados numéricos pré-agregados, ideais para alertas. Logs têm alto volume e latência maior para processar, tornando métricas mais eficientes para monitoramento em tempo real."},
  {domain:"Observability", q:"Quando usar Pushgateway em vez do scrape padrão do Prometheus?", opts:["Para aplicações que rodam continuamente em containers","Para batch jobs de curta duração que terminam antes do próximo scrape","Para exporters que precisam de alta cardinalidade","Para scraping de endpoints HTTPS"], ans:1, exp:"<strong>Pushgateway</strong> resolve o problema de batch jobs que têm vida útil menor que o intervalo de scrape. O job faz push das métricas ao Pushgateway, que fica disponível para o Prometheus scrapar."},
  {domain:"Observability", q:"O que é cardinality no contexto do Prometheus?", opts:["O número de instâncias do Prometheus rodando","O número de time series únicas geradas por combinações de labels","A taxa de ingestão de métricas por segundo","A duração máxima de retenção de dados"], ans:1, exp:"<strong>Cardinality</strong> é o número de combinações únicas de labels, gerando time series distintas. Alta cardinality (ex: usar user_id como label) pode causar problemas sérios de performance e memória."},
  {domain:"Observability", q:"Qual a limitação principal do Prometheus para long-term storage?", opts:["Prometheus não suporta formato Protobuf","O storage local tem retenção padrão de 15 dias e não é adequado para análise histórica longa","Prometheus não consegue scrapar mais de 100 targets","Prometheus não tem suporte a backup automático"], ans:1, exp:"O storage local do Prometheus tem retenção padrão de 15 dias. Para long-term storage, use soluções externas como <strong>Thanos, Cortex, ou VictoriaMetrics</strong> com remote_write."},
  {domain:"Observability", q:"O que é um 'error budget' em SRE?", opts:["O custo de infraestrutura alocado para correção de bugs","A quantidade aceitável de downtime/erros antes de violar o SLO","O número máximo de alertas por dia permitidos","O tempo máximo para resolver um incidente"], ans:1, exp:"<strong>Error budget</strong> = 100% - SLO. Se o SLO é 99.9%, o error budget é 0.1% do tempo. Quando o budget está esgotado, o time deve priorizar confiabilidade sobre features novas."},

  // FUNDAMENTOS (10q)
  {domain:"Fundamentos", q:"Qual o tipo de métrica adequado para medir o número total de requisições HTTP recebidas?", opts:["Gauge","Counter","Histogram","Summary"], ans:1, exp:"<strong>Counter</strong> é usado para valores que só aumentam (ou resetam no reinício). Número total de requisições é um contador clássico. Use com rate() ou increase() para calcular taxas."},
  {domain:"Fundamentos", q:"Qual a porta padrão do Prometheus?", opts:[":9091",":9090",":9100",":3000"], ans:1, exp:"Prometheus expõe sua UI e API na porta <strong>:9090</strong> por padrão. Memorize: 9090=Prometheus, 9091=Pushgateway, 9093=Alertmanager, 9100=Node Exporter."},
  {domain:"Fundamentos", q:"Uma métrica Histogram gera automaticamente quais séries com sufixo?", opts:["_total e _avg","_bucket, _sum e _count","_p50, _p90 e _p99","_min e _max"], ans:1, exp:"Histogram gera 3 séries: <strong>_bucket</strong> (contagem por le), <strong>_sum</strong> (soma total dos valores) e <strong>_count</strong> (número de observações). Use histogram_quantile() para calcular percentis."},
  {domain:"Fundamentos", q:"Qual a diferença entre Histogram e Summary?", opts:["Histogram calcula percentis no servidor; Summary calcula no cliente","Summary calcula percentis no servidor; Histogram calcula no cliente","Ambos calculam percentis no servidor, mas com algoritmos diferentes","Histogram é para latência; Summary é apenas para tamanho de payload"], ans:0, exp:"<strong>Histogram</strong> armazena buckets e calcula percentis no servidor Prometheus (via histogram_quantile). <strong>Summary</strong> calcula percentis no próprio cliente da aplicação. Histogram permite agregação entre instâncias; Summary não."},
  {domain:"Fundamentos", q:"O que representa a métrica 'up' gerada pelo Prometheus?", opts:["CPU utilizada pelo processo Prometheus","1 se o último scrape do target foi bem-sucedido; 0 se falhou","Número de targets monitorados","Status da conexão com o Alertmanager"], ans:1, exp:"A métrica <strong>up</strong> é gerada automaticamente pelo Prometheus para cada target. Valor 1 = scrape bem-sucedido; 0 = scrape falhou. Clássico: <code>up == 0</code> para alertar targets down."},
  {domain:"Fundamentos", q:"Qual campo do prometheus.yml define com que frequência as regras são avaliadas?", opts:["scrape_interval","evaluation_interval","rule_interval","alert_interval"], ans:1, exp:"<strong>evaluation_interval</strong> no bloco global define a frequência com que as alerting e recording rules são avaliadas. scrape_interval define a frequência de coleta de métricas."},
  {domain:"Fundamentos", q:"O que é um 'target' no contexto do Prometheus?", opts:["Um servidor Alertmanager configurado","Um endpoint HTTP que o Prometheus scrapa para coletar métricas","Uma regra de alerta definida no arquivo de rules","Um receptor de notificações no Alertmanager"], ans:1, exp:"<strong>Target</strong> é qualquer endpoint que o Prometheus monitora — um host, pod, serviço, etc. — que expõe métricas no formato Prometheus em um endpoint <code>/metrics</code>."},
  {domain:"Fundamentos", q:"Qual o formato de naming convention recomendado para métricas?", opts:["camelCase com sufixos tipo _Rate e _Total","snake_case: namespace_subsystem_name_unit (ex: http_requests_total)","PascalCase sem underscores","Qualquer formato, pois o Prometheus normaliza automaticamente"], ans:1, exp:"A convenção é <strong>snake_case</strong> com estrutura: <code>namespace_subsystem_name_unit</code>. Sufixos padrão: _total (counters), _seconds (tempo), _bytes (tamanho), _ratio (0-1)."},
  {domain:"Fundamentos", q:"Qual é o armazenamento padrão do Prometheus?", opts:["PostgreSQL com extensão timescale","Cassandra distribuído","TSDB (Time Series Database) local em disco","InfluxDB"], ans:2, exp:"Prometheus usa seu próprio <strong>TSDB (Time Series Database)</strong> local, otimizado para dados de séries temporais. É eficiente mas não projetado para longa retenção ou alta disponibilidade."},
  {domain:"Fundamentos", q:"O que é relabeling no Prometheus?", opts:["Renomear alertas no Alertmanager","Transformar, filtrar ou adicionar labels antes ou após o scrape","Criar dashboards com labels personalizadas no Grafana","Exportar labels para sistemas externos"], ans:1, exp:"<strong>Relabeling</strong> permite transformar labels de targets antes (relabel_configs) ou após (metric_relabel_configs) o scrape. Pode filtrar targets, renomear labels e adicionar metadata."},

  // PROMQL (16q)
  {domain:"PromQL", q:"Qual query calcula a taxa de requisições por segundo nos últimos 5 minutos?", opts:["increase(http_requests_total[5m])","rate(http_requests_total[5m])","delta(http_requests_total[5m])","sum(http_requests_total)"], ans:1, exp:"<strong>rate()</strong> calcula a taxa por segundo de um counter sobre o range especificado. É a função mais usada para visualizar counters. increase() retorna o total no período, não a taxa."},
  {domain:"PromQL", q:"Qual a diferença entre rate() e irate()?", opts:["rate() usa os 2 últimos pontos; irate() usa todos os pontos do range","irate() usa os 2 últimos pontos (mais reativo); rate() usa todo o range (mais suave)","São equivalentes, apenas com sintaxe diferente","irate() é mais preciso para períodos longos"], ans:1, exp:"<strong>irate()</strong> calcula a taxa usando apenas os 2 últimos pontos — mais reativo a mudanças. <strong>rate()</strong> usa todo o range — mais suave e estável. rate() é melhor para alertas; irate() para dashboards real-time."},
  {domain:"PromQL", q:"O que retorna a query: sum(http_requests_total) by (status_code)?", opts:["A soma de todas as requisições sem agrupamento","A soma de requisições agrupada por status_code, com uma série por código","A quantidade de séries por status_code","O percentil 99 das requisições por status_code"], ans:1, exp:"<strong>by (label)</strong> mantém apenas os labels especificados e agrupa os valores. O resultado terá uma série para cada valor único de status_code com a soma das requisições."},
  {domain:"PromQL", q:"Qual query encontra os 5 jobs com maior número de erros?", opts:["max(errors_total) by (job)","topk(5, sum(errors_total) by (job))","sort_desc(sum(errors_total) by (job))","limit(5, sum(errors_total) by (job))"], ans:1, exp:"<strong>topk(n, expr)</strong> retorna as n séries com maiores valores. <code>topk(5, sum(errors_total) by (job))</code> soma erros por job e retorna os 5 maiores."},
  {domain:"PromQL", q:"Para calcular o percentil 99 de latência usando um Histogram, qual função usar?", opts:["quantile(0.99, latency_seconds)","percentile(99, latency_seconds_bucket)","histogram_quantile(0.99, rate(latency_seconds_bucket[5m]))","p99(latency_seconds)"], ans:2, exp:"<strong>histogram_quantile(φ, b)</strong> calcula o quantil φ a partir dos buckets de um Histogram. Sempre precisa de rate() nos buckets: <code>histogram_quantile(0.99, rate(metric_bucket[5m]))</code>"},
  {domain:"PromQL", q:"O que faz 'sum without (pod)' em uma agregação?", opts:["Exclui o label 'pod' dos resultados e mantém todos os outros labels","Mantém apenas o label 'pod' e remove os demais","Filtra séries onde pod está vazio","Remove todas as séries do pod especificado"], ans:0, exp:"<strong>without (label)</strong> é o oposto de by(): mantém todos os labels EXCETO os listados. <code>sum without (pod)</code> soma agrupando por tudo exceto pod, útil para agregar por job/instance."},
  {domain:"PromQL", q:"Qual label matcher usa regex para incluir status codes 4xx e 5xx?", opts:['status_code="4..|5.."','status_code=~"[45].."','status_code!="2.."','status_code~="[45].."'], ans:1, exp:"<strong>=~</strong> é o matcher de regex. <code>status_code=~\"[45]..\"</code> seleciona qualquer código começando com 4 ou 5. Note: a regex é sempre ancorada — equivale a ^[45]..$"},
  {domain:"PromQL", q:"O que é um 'range vector' em PromQL?", opts:["Um vetor com valores em diferentes regiões geográficas","Um conjunto de samples de uma time series dentro de um intervalo de tempo","Uma série com valores ordenados em ranking","Múltiplas métricas combinadas com operadores binários"], ans:1, exp:"<strong>Range vector</strong> é representado por <code>metric[5m]</code> — retorna todos os samples da série nos últimos 5 minutos. Funções como rate() e increase() requerem range vectors."},
  {domain:"PromQL", q:"Qual query alerta se o disco vai encher em menos de 4 horas?", opts:["node_filesystem_avail_bytes < 10","predict_linear(node_filesystem_avail_bytes[1h], 4*3600) < 0","rate(node_filesystem_avail_bytes[1h]) > 0","increase(node_filesystem_size_bytes[4h]) > 0"], ans:1, exp:"<strong>predict_linear(v, t)</strong> projeta o valor daqui a t segundos usando regressão linear sobre o range v. Se o resultado for < 0, o disco vai encher antes de t segundos."},
  {domain:"PromQL", q:"O que faz a função absent()?", opts:["Remove séries com valores ausentes (NaN)","Retorna 1 se a série NÃO existe; nada se existe — útil para alertar targets ausentes","Substitui valores ausentes por zero","Filtra séries com labels undefined"], ans:1, exp:"<strong>absent()</strong> retorna um vetor com valor 1 se a expressão não tem dados. Essencial para alertar quando uma métrica desaparece: <code>absent(up{job='api'})</code> dispara se o job api some."},
  {domain:"PromQL", q:"Qual é o resultado de 'sum(rate(errors[5m])) / sum(rate(requests[5m]))'?", opts:["O número absoluto de erros","A taxa de erros como proporção do total de requisições","O tempo médio de resposta","O número de instâncias com erro"], ans:1, exp:"Esta query calcula o <strong>error ratio</strong> — fração de erros sobre o total. Multiplique por 100 para percentual. Padrão clássico para alertas de SLO: <code>> 0.01</code> = mais de 1% de erros."},
  {domain:"PromQL", q:"Como selecionar todas as instâncias EXCETO a de staging?", opts:['instance="prod"','instance!="staging"','instance=~"prod.*"','instance!~"staging.*"'], ans:1, exp:"<strong>!=</strong> é o label matcher de negação exata. <code>instance!=\"staging\"</code> exclui exatamente a instância chamada 'staging'. Use !~ para negação com regex."},
  {domain:"PromQL", q:"O que são Recording Rules e quando usar?", opts:["Regras que gravam logs de auditoria do Prometheus","Expressões PromQL pré-computadas e armazenadas, usadas para queries pesadas e recorrentes","Regras que fazem backup das métricas em remote storage","Configurações de scrape salvas para reutilização"], ans:1, exp:"<strong>Recording Rules</strong> pré-computam expressões PromQL e armazenam o resultado como nova métrica. Use para queries complexas usadas em vários alertas/dashboards, melhorando performance. Naming: <code>level:metric:operations</code>"},
  {domain:"PromQL", q:"Qual operador binário de matching usar quando 'on' labels não correspondem 1:1?", opts:["group_left() ou group_right()","by() ou without()","on() sozinho","ignore()"], ans:0, exp:"<strong>group_left()</strong> e <strong>group_right()</strong> são usados em joins many-to-one. Ex: <code>metric_a * on(job) group_left(label) metric_b</code> — multiplica métricas onde 'a' tem muitos para um 'b'."},
  {domain:"PromQL", q:"O que retorna 'rate(counter[1m])' se o counter resetou no período?", opts:["Um valor negativo indicando o reset","Zero, pois o reset invalida o cálculo","rate() detecta resets e ajusta automaticamente o cálculo","Um erro de sintaxe"], ans:2, exp:"<strong>rate()</strong> detecta automaticamente resets de counters (quando o valor cai) e ajusta o cálculo. Por isso é preferível a subtrações manuais de counters."},
  {domain:"PromQL", q:"Qual a diferença entre delta() e increase()?", opts:["delta() é para counters; increase() é para gauges","delta() é para gauges (pode ser negativo); increase() é para counters","São equivalentes","increase() inclui extrapolação; delta() não"], ans:1, exp:"<strong>delta()</strong> calcula a diferença simples para <strong>Gauges</strong>. <strong>increase()</strong> é para <strong>Counters</strong> e inclui extrapolação para bordas do range. Não misture os dois com tipos errados."},

  // INSTRUMENTAÇÃO (7q)
  {domain:"Instrumentação", q:"Qual exporter é usado para coletar métricas de CPU, memória e disco do host?", opts:["cAdvisor","Blackbox Exporter","Node Exporter","Pushgateway"], ans:2, exp:"<strong>Node Exporter</strong> expõe métricas do sistema operacional host: CPU, memória, disco, rede, etc. Roda na porta :9100 e é o exporter padrão para monitoramento de infraestrutura."},
  {domain:"Instrumentação", q:"Qual exporter monitora métricas de containers Docker/Kubernetes?", opts:["Node Exporter","cAdvisor","Blackbox Exporter","kube-state-metrics"], ans:1, exp:"<strong>cAdvisor</strong> (Container Advisor) coleta métricas de containers: CPU, memória, I/O. Já integrado no kubelet do Kubernetes. Porta padrão :8080."},
  {domain:"Instrumentação", q:"Para que serve o Blackbox Exporter?", opts:["Monitorar métricas internas de aplicações black-box","Fazer probes de endpoints HTTP, TCP, ICMP — testar disponibilidade externa","Exportar métricas de bancos de dados","Substituir o Node Exporter em ambientes containerizados"], ans:1, exp:"<strong>Blackbox Exporter</strong> testa endpoints de fora (como um usuário): verifica se HTTP retorna 200, se TCP conecta, se ICMP responde. Ideal para checar disponibilidade e SSL certificates."},
  {domain:"Instrumentação", q:"Qual a convenção de naming para uma métrica de latência de requisições HTTP?", opts:["httpRequestDurationSeconds","http_request_duration","http_request_duration_seconds","HttpRequestDurationSecs"], ans:2, exp:"A convenção é <strong>snake_case</strong> com sufixo de unidade: <code>http_request_duration_seconds</code>. Nunca abrevie unidades (não _secs). Sufixos padrão: _seconds, _bytes, _total, _ratio."},
  {domain:"Instrumentação", q:"Por que NÃO usar user_id como label em uma métrica?", opts:["Labels devem ser apenas strings, não números","Alta cardinality — milhões de user_ids criariam milhões de time series, degradando performance","Prometheus não aceita labels com underscore","Labels são case-sensitive e user_id pode conflitar"], ans:1, exp:"Labels com alta cardinality (como user_id, request_id) criam uma time series por valor único, podendo gerar milhões de séries. Isso sobrecarrega memória e TSDB. Use em logs, não em métricas."},
  {domain:"Instrumentação", q:"Qual client library NÃO é oficialmente suportada pelo Prometheus?", opts:["Go","Python","PHP","Java"], ans:2, exp:"As client libraries oficiais do Prometheus são: <strong>Go, Java/Scala, Python e Ruby</strong>. PHP não tem biblioteca oficial — existem bibliotecas de terceiros. Go é a linguagem nativa do Prometheus."},
  {domain:"Instrumentação", q:"O que o Pushgateway faz com as métricas após o job terminar?", opts:["Apaga automaticamente após o TTL configurado","Mantém as métricas indefinidamente até serem deletadas manualmente ou via API","Envia imediatamente ao Prometheus","Agrega com outros jobs do mesmo tipo"], ans:1, exp:"<strong>Pushgateway persiste as métricas</strong> mesmo após o job terminar — é exatamente para isso que serve! Para limpar, o job deve deletar suas métricas via API (<code>DELETE /metrics/job/{job}</code>) ou por tempo de vida configurado."},

  // ALERTING (8q)
  {domain:"Alerting", q:"Qual o estado de um alerta que acabou de ter sua condição satisfeita mas ainda não passou pelo campo 'for'?", opts:["firing","inactive","pending","warning"], ans:2, exp:"<strong>pending</strong>: a condição foi satisfeita mas o tempo definido em <code>for</code> ainda não passou. Depois do 'for', o alerta passa para <strong>firing</strong>. Sem 'for', vai direto para firing."},
  {domain:"Alerting", q:"O que faz o campo 'for: 5m' em uma alerting rule?", opts:["O alerta expira após 5 minutos","O alerta precisa estar em pending por 5 minutos antes de disparar","O Alertmanager aguarda 5 minutos para enviar a notificação","O alerta é avaliado a cada 5 minutos"], ans:1, exp:"<strong>for</strong> define o tempo mínimo que a condição deve ser satisfeita antes de disparar. Evita falsos positivos de picos momentâneos. O alerta fica em 'pending' durante esse período."},
  {domain:"Alerting", q:"Qual a função do 'group_wait' no Alertmanager?", opts:["Tempo de espera entre notificações do mesmo grupo","Tempo inicial de espera antes de enviar a primeira notificação de um novo grupo","Tempo de cooldown após resolver um alerta","Tempo máximo de processamento de um alerta"], ans:1, exp:"<strong>group_wait</strong> é o tempo que o Alertmanager aguarda para juntar alertas do mesmo grupo antes de enviar a primeira notificação. Permite agrupar alertas que chegam juntos. Padrão: 30s."},
  {domain:"Alerting", q:"O que é 'inhibition' no Alertmanager?", opts:["Silenciar alertas manualmente por um período","Impedir que alertas menos críticos sejam enviados quando um alerta mais crítico está ativo","Agrupar alertas similares em uma única notificação","Rotear alertas para diferentes canais por severidade"], ans:1, exp:"<strong>Inhibition</strong> suprime alertas menos relevantes quando um alerta mais crítico está disparando. Ex: se o host está down, inibe alertas de apps nesse host — pois a causa raiz já é conhecida."},
  {domain:"Alerting", q:"Qual campo de uma alert rule é destinado a informações legíveis por humanos como 'runbook' e descrição?", opts:["labels","annotations","expr","summary_config"], ans:1, exp:"<strong>annotations</strong> contém informações legíveis para humanos: summary, description, runbook_url, etc. <strong>labels</strong> são usados para roteamento e silenciamentos. São campos distintos!"},
  {domain:"Alerting", q:"Como o Alertmanager agrupa alertas?", opts:["Sempre envia um alerta por vez","Agrupa alertas com os mesmos labels definidos em group_by, enviando como um pacote","Agrupa por severidade automaticamente","Agrupa apenas alertas idênticos"], ans:1, exp:"<strong>group_by</strong> no Alertmanager define quais labels usar para agrupar alertas. Ex: <code>group_by: ['alertname', 'cluster']</code> — alertas com mesmo alertname e cluster são agrupados em uma notificação."},
  {domain:"Alerting", q:"Qual a diferença entre 'silence' e 'inhibition' no Alertmanager?", opts:["São sinônimos no contexto do Alertmanager","Silence suprime manualmente por critérios; inhibition suprime automaticamente baseado em outros alertas","Silence é permanente; inhibition é temporário","Inhibition funciona por label; silence funciona por tempo"], ans:1, exp:"<strong>Silence</strong>: supressão manual por um período de tempo (maintenance window). <strong>Inhibition</strong>: supressão automática baseada na presença de outro alerta específico — configurado em arquivo."},
  {domain:"Alerting", q:"Como configurar um painel Grafana para usar dados do Prometheus?", opts:["Importar o prometheus.yml diretamente no Grafana","Configurar um Datasource do tipo Prometheus com a URL do servidor e usar PromQL nas queries","Usar o plugin node_exporter_full do Grafana","Conectar via SSH ao servidor Prometheus"], ans:1, exp:"No Grafana, configure um <strong>Datasource → Prometheus</strong> com a URL do servidor (ex: http://prometheus:9090). Nos painéis, use PromQL para consultar dados. Grafana suporta variáveis e templates com PromQL."},
];

let answered = {};
let currentFilter = 'all';
let score = 0;
let total = 0;

(function initFromStorage() {
  const savedAnswered = localStorage.getItem('pca_quiz_answered');
  const savedScore = localStorage.getItem('pca_quiz_score');
  const savedTotal = localStorage.getItem('pca_quiz_total');
  if (savedAnswered) {
    const parsed = JSON.parse(savedAnswered);
    Object.assign(answered, parsed);
    score = parseInt(savedScore || '0', 10);
    total = parseInt(savedTotal || '0', 10);
  }
  const visitedDays = JSON.parse(localStorage.getItem('pca_visited_days') || '[]');
  if (visitedDays.length > 0) {
    setTimeout(() => markVisitedDays(visitedDays), 0);
  }
})();

function filterQuiz(domain) {
  currentFilter = domain;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  renderQuiz();
}

function renderQuiz() {
  const container = document.getElementById('quizContainer');
  const filtered = currentFilter === 'all' ? questions : questions.filter(q => q.domain === currentFilter);
  
  container.innerHTML = '';
  filtered.forEach((q, i) => {
    const globalIdx = questions.indexOf(q);
    const letters = ['A','B','C','D'];
    const isAnswered = answered[globalIdx] !== undefined;
    
    const card = document.createElement('div');
    card.className = 'question-card';
    card.innerHTML = `
      <div class="question-num">
        <span>Q${i+1}</span>
        <span class="tag tag-${domainTag(q.domain)}">${q.domain}</span>
      </div>
      <div class="question-text">${q.q}</div>
      <div class="options">
        ${q.opts.map((opt, j) => {
          let cls = 'option-btn';
          let indicator = '';
          if (isAnswered) {
            if (j === q.ans) { cls += ' correct'; indicator = '<span class="opt-indicator" aria-label="Correto">✓</span>'; }
            else if (j === answered[globalIdx] && j !== q.ans) { cls += ' wrong'; indicator = '<span class="opt-indicator" aria-label="Incorreto">✗</span>'; }
          }
          return `<button class="${cls}" ${isAnswered?'disabled':''} onclick="answer(${globalIdx}, ${j})">
            <span class="option-letter">${letters[j]}</span>
            <span>${opt}</span>
            ${indicator}
          </button>`;
        }).join('')}
      </div>
      <div class="explanation ${isAnswered?'show':''}" id="exp-${globalIdx}">
        ${q.exp}
      </div>
    `;
    container.appendChild(card);
  });
  updateScore();
}

function domainTag(d) {
  const m = {PromQL:'promql',Fundamentos:'fund',Observability:'obs',Alerting:'alert',Instrumentação:'inst'};
  return m[d]||'fund';
}

function answer(idx, chosen) {
  if (answered[idx] !== undefined) return;
  answered[idx] = chosen;
  const q = questions[idx];
  total++;
  if (chosen === q.ans) score++;
  localStorage.setItem('pca_quiz_answered', JSON.stringify(answered));
  localStorage.setItem('pca_quiz_score', String(score));
  localStorage.setItem('pca_quiz_total', String(total));
  renderQuiz();
  const exp = document.getElementById('exp-' + idx);
  if (exp) exp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function updateScore() {
  document.getElementById('scoreDisplay').textContent = `Score: ${score}/${total}`;
  const pct = total > 0 ? Math.round(score/total*100) : 0;
  document.getElementById('progressDisplay').textContent = total > 0 ? `${pct}% correto` : '';
  const final = document.getElementById('finalScore');
  if (total === questions.length) {
    final.textContent = `Resultado final: ${score}/${questions.length} (${pct}%)`;
    final.style.color = pct >= 75 ? 'var(--promql)' : 'var(--accent3)';
  }
}

function resetQuiz() {
  answered = {};
  score = 0;
  total = 0;
  localStorage.removeItem('pca_quiz_answered');
  localStorage.removeItem('pca_quiz_score');
  localStorage.removeItem('pca_quiz_total');
  renderQuiz();
  document.getElementById('finalScore').textContent = '';
}

renderQuiz();
